# Node.js 与 Python 运行缓存
node_modules/
__pycache__/
*.pyc
.env
.env.*
*.local.json

# 本地运行时数据库、桥接凭证与语音缓存（防隐私及密钥泄露）
data/
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db
data/antigravity_bridge.json
data/tts_cache/

# 安卓安装包与签名文件（APK 通过 GitHub Releases 发布）
*.apk
*.idsig
*.keystore
*.jks

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
*.tar.gz
*.tmp
.deploy.local.json
